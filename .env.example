# Copy to .env.local and fill in. Never commit .env.local.
#
# The Supabase SERVICE-ROLE key is deliberately absent from this file. It is set
# in Vercel server environment variables only, is used by exactly one code path
# (account deletion), and must never appear in a local file or in git history.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
